# Local environment — copy to .env and fill in values
#   cp .env.example .env

# General
TZ=Europe/Berlin

# ---------------------------------------------------------------------------
# Storage backend (FUSE mount — media stays on Hetzner, not copied to the VPS)
#   objectstorage — Hetzner Object Storage (S3) — default sidecar compose
#   storagebox    — Hetzner Storage Box (SFTP) — add compose.storagebox.yml
# ---------------------------------------------------------------------------
STORAGE_BACKEND=objectstorage

# Hetzner Object Storage (sidecar when STORAGE_BACKEND=objectstorage)
# Used via RCLONE_CONFIG_* env vars in compose.yml / compose.core.yml
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_BUCKET=my-audiobooks

# Hetzner Storage Box (sidecar when using compose.storagebox.yml /
# compose.coolify.storagebox.yml)
# Enable SSH support in Hetzner Console. Port 23 is required.
STORAGEBOX_HOST=uXXXXX.your-storagebox.de
STORAGEBOX_USER=uXXXXX
STORAGEBOX_PASS=
STORAGEBOX_PORT=23
# Prefix on the box (include trailing slash). For media/audiobooks use:
STORAGEBOX_PATH=media/
# Folder names under STORAGEBOX_PATH (ABS still uses /audiobooks etc. inside the container)
STORAGEBOX_AUDIOBOOKS_DIR=audiobooks
STORAGEBOX_PODCASTS_DIR=podcast
STORAGEBOX_EBOOKS_DIR=ebooks

# Coolify 4.5+ Storage Box compose: put the PLAIN password in STORAGEBOX_PASS
# (the mount script runs rclone obscure). compose.storagebox.yml still expects
# an already-obscured STORAGEBOX_PASS via ./scripts/obscure-password.sh.
# Optional OpenSSH private key (port 23). Use \n for line breaks. When set, the
# password is not sent:
# STORAGEBOX_KEY_PEM=
# HOST_MNT_BASE is optional. Coolify sets COOLIFY_RESOURCE_UUID and the mount
# uses /data/coolify/applications/<uuid>/mnt. Leave Raw Compose off and assign
# the domain in the Coolify Domains UI (service audiobookshelf, port 80).
# When the storage box blocks this server, login attempts wait this long (default 15m):
# STORAGEBOX_BAN_BACKOFF=15m
# When the password or key is rejected, wait this long so a typo does not extend the block (default 10m):
# STORAGEBOX_AUTH_BACKOFF=10m

# Rclone volume plugin remote (compose.rclone-plugin*.yml)
# Object Storage: hetzner:${S3_BUCKET}
# Storage Box:    storagebox:   (or storagebox:media for a subfolder)
RCLONE_REMOTE=hetzner:${S3_BUCKET}

# rclone FUSE mount cache (local VPS disk used ONLY for this cache + ABS config)
# Media files are not synced onto the VPS. Lower VFS_CACHE_MAX_SIZE on small disks.
VFS_CACHE_MODE=full
VFS_CACHE_MAX_SIZE=2G
VFS_CACHE_MAX_AGE=72h
VFS_DIR_CACHE_TIME=72h

# Caddy reverse proxy
# Production HTTPS: set DOMAIN to your hostname and ACME_EMAIL for Let's Encrypt
# Local HTTP only: set DOMAIN=:80
DOMAIN=books.example.com
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Direct access when running a core file without Caddy
ABS_HOST_PORT=13378

# Optional library mounts (sidecar stack)
#   docker compose --profile podcasts --profile ebooks up -d
#   docker compose -f compose.yml -f compose.storagebox.yml --profile podcasts --profile ebooks up -d
ENABLE_PODCASTS=false
ENABLE_EBOOKS=false
