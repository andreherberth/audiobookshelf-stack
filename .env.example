# Local environment — copy to .env and fill in values
#   cp .env.example .env

# General
TZ=Europe/Berlin

# Hetzner Object Storage (sidecar stack — used via RCLONE_CONFIG_* env vars)
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fsn1
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_BUCKET=my-audiobooks

# Caddy reverse proxy
# Production HTTPS: set DOMAIN to your hostname and ACME_EMAIL for Let's Encrypt
# Local HTTP only: set DOMAIN=:80
DOMAIN=books.example.com
ACME_EMAIL=you@example.com
HTTP_PORT=80
HTTPS_PORT=443

# Direct access when running a core file without Caddy
ABS_HOST_PORT=13378

# Optional: enable podcast S3 mount (sidecar stack only)
# Start with: docker compose --profile podcasts up -d
ENABLE_PODCASTS=false
